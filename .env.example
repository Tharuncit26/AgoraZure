# AgoraZure Configuration
# Database (SQLite by default, easily swapped to PostgreSQL)
DATABASE_URL=sqlite:///./agorazure.db

# Azure OpenAI Configuration (for AI Demand Insights and Smart Substitutes)
# If missing, the app gracefully falls back to intelligent rule-based responses
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Application Security
SECRET_KEY=agorazure-zephyr-2026-secret-key-ps2
