# =============================================================================
# AgoraZure - Environment Variables & Production Vercel Configuration
# =============================================================================

# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Cloud SQL / SQLite)
# For Local Development:
DATABASE_URL=sqlite:///./agorazure.db

# For Production (Add this in Vercel Project Settings -> Environment Variables):
# Example Supabase Connection String (Transaction pooler on port 6543 or session on 5432):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# (Note: AgoraZure automatically configures pg8000 driver and SSL)

# 2. APPLICATION SECURITY
SECRET_KEY=agorazure-zephyr-2026-secret-key-ps2

# 3. AZURE OPENAI CONFIGURATION (Optional - smart local fallbacks are active if left blank)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 4. SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
ENV=production
