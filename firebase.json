{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/shopper",
        "destination": "/shopper.html"
      },
      {
        "source": "/shopkeeper",
        "destination": "/shopkeeper.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
